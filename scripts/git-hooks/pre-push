#!/bin/sh
# Refuse a push whose Python files would fail CI's Ruff step (scripts/ruff-committed.py).
# Installed with: git config core.hooksPath scripts/git-hooks
root=$(git rev-parse --show-toplevel) || exit 1
python=python3
[ -x "$root/.local/lab-venv/bin/python" ] && python="$root/.local/lab-venv/bin/python"
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    base=$(git merge-base origin/main "$local_sha" 2>/dev/null) || base=$(git hash-object -t tree /dev/null)
  else
    base=$remote_sha
  fi
  "$python" "$root/scripts/ruff-committed.py" "$base" "$local_sha" || status=1
done
[ $status = 0 ] || echo "pre-push: refusing the push; CI's Ruff step would fail (see above)." >&2
exit $status
