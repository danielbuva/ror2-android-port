#!/bin/sh
# Check the committed content being pushed in a fresh checkout. Run Ruff and the
# audits plus affected host tests (or the full suite when the impact is unclear).
# Installed with: git config core.hooksPath scripts/git-hooks. Bypass only with the operator's say-so.
root=$(git rev-parse --show-toplevel) || exit 1
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  # A repair creates a local descendant; Git cannot change the in-flight tip.
  python3 -B "$root/scripts/journal-pre-push.py" "$local_ref" "$local_sha" "$remote_ref" || exit 1
  if [ "$remote_sha" = "$zero" ]; then
    base=$(git merge-base origin/main "$local_sha" 2>/dev/null) || base=$(git hash-object -t tree /dev/null)
  else
    base=$remote_sha
  fi
  python3 "$root/scripts/lab/source_pins.py" check --commit "$local_sha" --base "$base" --refresh-for-push "$local_ref" || {
    status=1
    continue
  }
  "$root/scripts/ci-local.sh" "$local_sha" "$base" --pre-push || status=1
done
[ $status = 0 ] || echo "pre-push: refusing the push; a local CI check failed (see above)." >&2
exit $status
