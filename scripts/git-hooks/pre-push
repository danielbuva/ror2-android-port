#!/bin/sh
# Refuse a push that would fail GitHub's host-tests check: scripts/ci-local.sh runs its steps
# (Ruff on changed files, audits, host tests) on the committed content being pushed, in a fresh
# checkout with the Unity install hidden and case-sensitive temp files. Only source objects
# and keyed dependencies are reused; all checks run again for every pushed commit.
# Installed with: git config core.hooksPath scripts/git-hooks. Bypass only with the operator's say-so.
root=$(git rev-parse --show-toplevel) || exit 1
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    base=$(git merge-base origin/main "$local_sha" 2>/dev/null) || base=$(git hash-object -t tree /dev/null)
  else
    base=$remote_sha
  fi
  "$root/scripts/ci-local.sh" "$local_sha" "$base" || status=1
done
[ $status = 0 ] || echo "pre-push: refusing the push; GitHub's host-tests check would fail (see above)." >&2
exit $status
